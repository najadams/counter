{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "counter-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "counter-friendly",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:friendly"],
      "port": 5175
    },
    {
      "name": "counter-lan",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "scripts/serve-lan.ts"
      ],
      "port": 4181
    },
    {
      "name": "counter-friendly-app",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "cross-env",
        "COUNTER_FRIENDLY=1",
        "COUNTER_HTTP=1",
        "COUNTER_HTTP_HOST=0.0.0.0",
        "vite"
      ],
      "port": 5175
    }
  ]
}
